# Never place a real key in a committed file.
DEEPSEEK_API_KEY=replace_with_a_new_rotated_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Current model names as of 2026-08-09.
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_AUDIT_MODEL=deepseek-v4-pro

# Application defaults
RESUME_WORKER_COUNT=8
RESUME_EXTRACTION_CONCURRENCY=8
RESUME_ANALYSIS_CONCURRENCY=8
RESUME_BATCH_SIZE=5
RESUME_EXCEL_FLUSH_EVERY=20
RESUME_MAX_RETRIES=2
